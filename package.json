{
  "name": "next-kra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Mohit Yadav",
    "email": "mohit@mohitya.dev",
    "url": "https://mohitya.dev"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@reduxjs/toolkit": "^2.8.2",
    "@remotion/bundler": "4.0.314",
    "@remotion/cli": "4.0.314",
    "@remotion/google-fonts": "4.0.314",
    "@remotion/lambda": "4.0.314",
    "@remotion/paths": "4.0.314",
    "@remotion/player": "4.0.314",
    "@remotion/shapes": "4.0.314",
    "@remotion/tailwind-v4": "4.0.314",
    "clsx": "2.1.1",
    "electron-is-dev": "^3.0.1",
    "file-saver": "^2.0.5",
    "next": "15.2.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0",
    "redux-persist-indexeddb-storage": "^1.0.4",
    "remotion": "4.0.314",
    "tailwind-merge": "3.0.1",
    "zod": "3.22.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.1.0",
    "@next/eslint-plugin-next": "15.1.6",
    "@remotion/eslint-plugin": "4.0.314",
    "@swc/core": "^1.12.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "20.12.14",
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/web": "0.0.166",
    "autoprefixer": "10.4.20",
    "child_process": "^1.0.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.0.3",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "eslint": "9.19.0",
    "eslint-config-next": "15.1.6",
    "ignore-loader": "^0.1.2",
    "postcss": "8.4.47",
    "prettier": "3.3.3",
    "tailwindcss": "4.0.3",
    "typescript": "5.8.2",
    "uglify-js": "^3.19.3",
    "wait-on": "^8.0.3"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev",
    "build": "cross-env NODE_ENV=developmentnext build",
    "build:prod": "cross-env NODE_ENV=production next build",
    "start": "next start",
    "lint": "next lint",
    "remotion": "remotion studio",
    "render": "remotion render",
    "deploy": "node deploy.mjs",
    "electron:build": "npm run build:prod && electron-builder",
    "electron-pack": "yarn build:prod && electron-builder build --mac --win --linux",
    "electron-mac": "yarn build:prod && electron-builder build --mac",
    "electron-win": "yarn build:prod && electron-builder build --win",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:prod": "next build && cross-env NODE_ENV=production electron ."
  },
  "build": {
    "appId": "com.yourcompany.nextkra",
    "productName": "Next-KRA",
    "files": [
      "out/**/*",
      "main.js",
      "preload.js"
    ],
    "directories": {
      "buildResources": "public"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  },
  "main": "main.js"
}
